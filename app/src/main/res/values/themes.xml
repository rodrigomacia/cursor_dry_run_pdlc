<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KaraokeApp" parent="android:Theme.Material.NoTitleBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.KaraokeApp.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1A0A2E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.KaraokeApp</item>
    </style>
</resources>
